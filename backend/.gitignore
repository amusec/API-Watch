# =========================================================
# APIWatch
# Root .gitignore
# =========================================================


# -------------------------
# Java / Maven / Spring Boot
# -------------------------

target/
*.class

# Logs
*.log
logs/

# Spring Boot local configuration / secrets
application-local.properties
application-local.yml
application-local.yaml

# Environment variables / secrets
.env
.env.*
!.env.example


# -------------------------
# Maven Wrapper
# -------------------------

# Keep wrapper scripts and properties in Git:
# mvnw
# mvnw.cmd
# .mvn/wrapper/maven-wrapper.properties


# -------------------------
# React / Node.js
# -------------------------

node_modules/
dist/
build/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# -------------------------
# IntelliJ IDEA
# -------------------------

.idea/
*.iws
*.iml
*.ipr


# -------------------------
# Spring Tool Suite / Eclipse
# -------------------------

.apt_generated/
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/


# -------------------------
# VS Code
# -------------------------

.vscode/


# -------------------------
# NetBeans
# -------------------------

nbproject/private/
nbbuild/
nbdist/
.nb-gradle/


# -------------------------
# Operating System
# -------------------------

.DS_Store
Thumbs.db


# -------------------------
# Temporary Files
# -------------------------

*.tmp
*.temp
*.swp
*.swo